<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/accent_warm_light"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Avatar Khách hàng (Tròn) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_avatar_kh"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="Avatar khách hàng"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="@color/accent_warm"
            app:strokeWidth="1.5dp" />

        <!-- Thông tin chi tiết khách hàng -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Tên khách hàng -->
            <TextView
                android:id="@+id/tv_ten_kh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Khách Hàng 0325550962" />

            <!-- Số điện thoại / Tài khoản -->
            <TextView
                android:id="@+id/tv_sdt_kh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/primary_book"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="SĐT / Tài khoản: 0325550962" />

            <!-- Địa chỉ -->
            <TextView
                android:id="@+id/tv_dia_chi_kh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Địa chỉ: Chưa cập nhật địa chỉ" />

        </LinearLayout>

        <!-- Nút Xóa (Chỉ có phần Xóa) -->
        <ImageButton
            android:id="@+id/btn_delete_kh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Xóa khách hàng"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/error_red" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>