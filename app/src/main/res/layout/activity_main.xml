<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_paper"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Header Banner Top -->
    <LinearLayout
        android:id="@+id/layout_header_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_book"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/app_name"
            android:src="@android:drawable/ic_menu_agenda"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_header_user_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xin chào Nhân viên"
                android:textColor="@color/accent_warm_light"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Main Container FrameLayout cho các Fragment -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Navigation Bar với 4 Tab: Sách - Hóa đơn - Khách hàng - Cài đặt -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="8dp"
        app:itemIconTint="@color/primary_book"
        app:itemTextColor="@color/primary_book"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_nhan_vien" />

</LinearLayout>
