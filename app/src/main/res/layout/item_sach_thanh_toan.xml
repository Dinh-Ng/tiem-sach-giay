<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingHorizontal="12dp">

    <!-- Ảnh bìa nhỏ -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/img_thanh_toan_sach"
        android:layout_width="48dp"
        android:layout_height="68dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_book_placeholder"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />

    <!-- Thông tin tên, tác giả, số lượng -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_thanh_toan_ten_sach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Dế Mèn Phiêu Lưu Ký" />

        <TextView
            android:id="@+id/tv_thanh_toan_tac_gia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Tô Hoài" />

        <TextView
            android:id="@+id/tv_thanh_toan_so_luong_gia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="85.000 ₫ x 2" />
    </LinearLayout>

    <!-- Thành tiền -->
    <TextView
        android:id="@+id/tv_thanh_toan_thanh_tien"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/accent_warm"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="170.000 ₫" />

</LinearLayout>
